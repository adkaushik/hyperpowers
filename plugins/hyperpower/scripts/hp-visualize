footer{margin-top:44px;padding-top:18px;border-top:1px solid var(--rule);color:var(--ink3);font-size:13px}
</style>
"""


def main(argv):
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", help="repo root. Default: the working directory.")
    ap.add_argument("--session", help="session id. Default: the newest for this repo.")
    ap.add_argument("--out", help="where to write the report.")
    ap.add_argument("--redact", action="store_true",
                    help="hash file paths before writing. Use before sharing the report.")
    ap.add_argument("--runs", type=int, default=5, metavar="N",
                    help="harness runs to include, newest first. Default 5.")
    ap.add_argument("--gaps", type=int, default=15, metavar="N",
                    help="longest gaps to list. Default 15.")
    ap.add_argument("--list", action="store_true", help="list sessions and exit.")
    args = ap.parse_args(argv)

    root = os.path.abspath(args.root or os.getcwd())
    pdir = project_dir(root)
    sessions = find_sessions(pdir)

    if args.list:
        if not sessions:
            die("no sessions recorded for %s" % root, EXIT_NO_LOGS)
        for _, sid, path in sessions[:20]:
            size = os.path.getsize(path) // 1024
            sys.stdout.write("%s  %6d KB\n" % (sid, size))
        return EXIT_OK

    if not sessions:
        die("no session logs under %s. Nothing to visualise." % pdir, EXIT_NO_LOGS)

    if args.session:
        match = [s for s in sessions if s[1].startswith(args.session)]
        if not match:
            die("no session id starting %s. Try --list." % args.session, EXIT_ERROR)
        _, sid, tpath = match[0]
    else:
        _, sid, tpath = sessions[0]

    transcript = read_transcript(tpath)
    if not transcript["calls"] and not transcript["turns"]:
        die("session %s recorded no assistant turns" % sid, EXIT_EMPTY)

    ctx = {
        "repo": root,
        "session": sid,
        "redact": args.redact,
        "transcript": transcript,
        "workflows": read_workflows(os.path.join(pdir, sid)),
        "hp_runs": read_hp_runs(root, args.runs),
        "timeline": longest_gaps(transcript["calls"], args.gaps),
    }

    out = args.out or os.path.join(state_root(root), "reports", "session-%s.html" % sid[:8])
    parent = os.path.dirname(out) or "."
    try:
        os.makedirs(parent, exist_ok=True)
        with open(out, "w", encoding="utf-8") as fh:
            fh.write(build_html(ctx))
    except OSError as exc:
        die("cannot write %s: %s" % (out, exc.strerror), EXIT_ERROR)

    sys.stdout.write("%s\n" % out)
    sys.stderr.write(
        "hp-visualize: %d turns, %d tool calls, %d workflow runs, %d harness runs.\n"
        % (transcript["turns"], len(transcript["calls"]),
           len(ctx["workflows"]), len(ctx["hp_runs"])))
    if not args.redact:
        sys.stderr.write(
            "hp-visualize: paths are unredacted. Rerun with --redact before sharing it.\n")
    return EXIT_OK


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(EXIT_ERROR)
