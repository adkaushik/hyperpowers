#!/usr/bin/env python3
"""hp-selfcheck - check the hyperpower plugin against its own documentation.

Thirteen mechanical checks over plugins/ and docs/. No model judgment, no network,
Python 3 standard library only. This validates the plugin itself. It never reads a
user's repo config.

Every finding prints as `path:line: [check] message`. Exit 1 on any error.

Exit codes: 0 every check passed, 1 at least one error, 2 bad usage.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_USAGE = 2

ERROR = "error"
WARN = "warn"

SKIP_DIRS = frozenset(
    (".git", "__pycache__", "node_modules", ".hyperpower", ".venv", "venv", "dist")
)

TEXT_SUFFIXES = frozenset(
    (
        "",
        ".md",
        ".py",
        ".js",
        ".sh",
        ".json",
        ".jsonl",
        ".yml",
        ".yaml",
        ".txt",
        ".cfg",
        ".toml",
    )
)

# The three placeholder markers the slop gate names. They are built from parts so this
# file does not itself contain the literal tokens it searches for. A literal here would
# make hp-selfcheck fail its own check 7.
SLOP_MARKERS = tuple("".join(parts) for parts in (("TO", "DO"), ("FIX", "ME"), ("X", "XX")))

# Descriptive prose that names the markers instead of deferring work. One entry per
# allowed line: the repo-relative path, and a substring that must appear on that line.
# A marker anywhere else is a finding.
# (path, needle). The needle must sit on the same line as the marker, so a file that
# documents what a marker looks like is exempt only on that exact line - not wholesale.
SLOP_ALLOWLIST = (
    ("docs/gates.md", "Catches placeholders"),
    ("plugins/hyperpower/skills/humanize/SKILL.md", "left behind"),
    ("docs/commands.md", "placeholders, deferrals, hedging"),
    ("plugins/hyperpower/skills/review/SKILL.md", "it is full of"),
)

# Top-level keys in the hyperpower.yml schema. Used to find config references in text.
