#!/usr/bin/env python3
"""run-tests - the hyperpower kernel test suite.

Discovers tests/cases/*.sh, runs each one in a fresh git repository under a temporary
directory, and prints one summary line. Exit 0 when every assertion passed, 1 when any
failed or any case crashed.

Python 3.8 or newer, standard library only. No third-party imports and no test framework.

A case never writes inside this repository. Each case gets its own scratch repo, its own
HOME, and its own temporary directory, and they are removed when the case ends. The runner
checks this repository afterwards and fails when a case left a file behind.

    ./run-tests                    every case
    ./run-tests --only hp-gates    the cases whose name matches the pattern
    ./run-tests --verbose          every assertion, plus each case's own output
    ./run-tests --keep             leave the scratch directories on disk
"""

import argparse
import fnmatch
import os
import shutil
import subprocess
import sys
