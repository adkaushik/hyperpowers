# Copy to .env.local (gitignored) and fill in.

# Pepper for hashing sign-in codes and session tokens. Required in production,
# at least 16 characters. Rotating it invalidates every code and session.
APP_SECRET=

# SQLite file. Relative paths resolve against the process working directory.
DATABASE_PATH=.data/hyperpowers.db

# Mail transport (nodemailer over SMTP). Either SMTP_URL on its own:
#   SMTP_URL=smtps://user:pass@smtp.yourhost.com:465
# or the discrete settings below. Without either, development prints the code
# to the server console and production refuses to start a sign-in.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave unset to infer from the port (465 = implicit TLS, otherwise STARTTLS).
SMTP_SECURE=
MAIL_FROM="Hyperpowers <login@yourdomain.com>"

# The header your hosting proxy sets to the visitor's address. On Fly.io this is
# fly-client-ip. Unset, every visitor shares one sign-in rate limit.
CLIENT_IP_HEADER=
